            "grant_certificate",
            "license_agreement",
            "landscape_review"
          ],
          "evidence_strength": {
            "strong": [
              "grant_certificate",
              "license_agreement"
            ],
            "weak": [
              "landscape_review"
            ]
          }
        },
        {
          "stage": 9,
