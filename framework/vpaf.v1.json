            "concept_note"
          ],
          "evidence_strength": {
            "strong": [
              "concept_note"
            ],
            "weak": []
          }
        },
        {
          "stage": 2,
          "band": "Explore",
          "descriptor": "The team has started checking what similar solutions exist and what others have already protected.",
          "evidence_required": [
            "landscape_review",
            "concept_note"
          ],
          "evidence_strength": {
            "strong": [
              "landscape_review"
            ],
            "weak": [
              "concept_note"
            ]
          }
        },
        {
          "stage": 3,
          "band": "Explore",
