  "dimensions": [
    {
      "code": "CUS",
      "name": "Customer",
      "stages": [
        {
          "stage": 1,
          "band": "Explore",
          "descriptor": "The team has written down who it believes has the problem, without yet speaking to any of them.",
          "evidence_required": [
            "concept_note"
          ],
          "evidence_strength": {
            "strong": [
              "concept_note"
            ],
            "weak": []
          }
        },
        {
          "stage": 2,
          "band": "Explore",
          "descriptor": "The team has held first conversations with people in the target group and recorded what they said.",
          "evidence_required": [
            "interview_log",
            "founder_notes"
          ],
          "evidence_strength": {
            "strong": [
              "interview_log"
            ],
            "weak": [
              "founder_notes"
            ]
          }
        },
        {
          "stage": 3,
          "band": "Explore",
          "descriptor": "The team has named one specific customer group and the problem it faces, based on recorded conversations.",
          "evidence_required": [
            "customer_profile",
            "interview_log"
          ],
          "evidence_strength": {
            "strong": [
              "customer_profile",
              "interview_log"
            ],
            "weak": []
          }
        },
        {
          "stage": 4,
          "band": "Validate",
          "descriptor": "Repeated interviews with the chosen customer group show the same problem, and the team can state why they would switch.",
          "evidence_required": [
            "interview_log",
            "customer_profile"
          ],
          "evidence_strength": {
            "strong": [
              "interview_log"
            ],
            "weak": [
              "customer_profile"
            ]
          }
        },
        {
          "stage": 5,
          "band": "Validate",
          "descriptor": "Target customers have used a version of the product, and their feedback is recorded and acted on.",
          "evidence_required": [
            "user_feedback_record",
            "usage_data",
            "interview_log"
          ],
          "evidence_strength": {
            "strong": [
              "user_feedback_record",
              "usage_data"
            ],
            "weak": [
              "interview_log"
            ]
          }
        },
        {
          "stage": 6,
          "band": "Validate",
          "descriptor": "At least one customer has signed a commitment to pilot or buy, with agreed measures of success.",
          "evidence_required": [
            "signed_loi",
            "pilot_agreement",
            "email_confirmation"
          ],
          "evidence_strength": {
            "strong": [
              "signed_loi",
              "pilot_agreement"
            ],
            "weak": [
              "email_confirmation"
            ]
          }
        },
        {
          "stage": 7,
          "band": "Scale",
          "descriptor": "Customers have paid for the product, and the team can describe how each sale was won.",
          "evidence_required": [
            "invoice",
            "payment_record",
            "signed_contract",
            "pipeline_report"
          ],
          "evidence_strength": {
            "strong": [
              "invoice",
              "payment_record",
              "signed_contract"
            ],
            "weak": [
              "pipeline_report"
            ]
          }
        },
        {
          "stage": 8,
          "band": "Scale",
          "descriptor": "Several customers have bought through the same sales steps, and each new customer is onboarded the same way.",
          "evidence_required": [
            "signed_contract",
            "invoice",
            "pipeline_report"
          ],
          "evidence_strength": {
            "strong": [
              "signed_contract",
              "invoice"
            ],
            "weak": [
              "pipeline_report"
            ]
          }
        },
        {
          "stage": 9,
          "band": "Scale",
          "descriptor": "New customers arrive at a predictable rate, existing customers stay or buy more, and some act as references.",
          "evidence_required": [
            "retention_data",
            "customer_reference",
            "pipeline_report"
          ],
          "evidence_strength": {
            "strong": [
              "retention_data",
              "customer_reference"
            ],
            "weak": [
              "pipeline_report"
            ]
          }
        }
      ]
    },
    {
      "code": "PRD",
      "name": "Product",
      "stages": [
        {
          "stage": 1,
          "band": "Explore",
          "descriptor": "The product exists only as a described idea, with nothing built or specified in detail.",
          "evidence_required": [
            "concept_note"
          ],
          "evidence_strength": {
            "strong": [
              "concept_note"
            ],
            "weak": []
          }
        },
        {
          "stage": 2,
          "band": "Explore",
          "descriptor": "The team has specified how the product will work and what a first build must show.",
          "evidence_required": [
            "design_document",
            "concept_note"
          ],
          "evidence_strength": {
            "strong": [
              "design_document"
            ],
            "weak": [
              "concept_note"
            ]
          }
        },
        {
          "stage": 3,
          "band": "Explore",
          "descriptor": "A first build exists and runs, but it fails often and has only been tried by the team.",
          "evidence_required": [
            "prototype_demo",
            "test_report"
          ],
          "evidence_strength": {
            "strong": [
              "prototype_demo"
            ],
            "weak": [
              "test_report"
            ]
          }
        },
        {
          "stage": 4,
          "band": "Validate",
          "descriptor": "The build performs its main functions in the team's own tests, with results recorded.",
          "evidence_required": [
            "test_report",
            "prototype_demo"
          ],
          "evidence_strength": {
            "strong": [
              "test_report"
            ],
            "weak": [
              "prototype_demo"
            ]
          }
        },
        {
          "stage": 5,
          "band": "Validate",
          "descriptor": "The build has been revised after testing, and recorded results show it now fails less often.",
          "evidence_required": [
            "test_report",
            "release_log"
          ],
          "evidence_strength": {
            "strong": [
              "test_report"
            ],
            "weak": [
              "release_log"
            ]
          }
        },
        {
          "stage": 6,
          "band": "Validate",
          "descriptor": "The product has worked in conditions close to real use, outside the team's own workplace.",
          "evidence_required": [
            "field_trial_report",
            "third_party_test_report",
            "prototype_demo"
          ],
          "evidence_strength": {
            "strong": [
              "field_trial_report",
              "third_party_test_report"
            ],
            "weak": [
              "prototype_demo"
            ]
          }
        },
        {
          "stage": 7,
          "band": "Scale",
          "descriptor": "Real users have operated the product in their own setting to do their actual work.",
          "evidence_required": [
            "deployment_record",
            "usage_data",
            "user_feedback_record"
          ],
          "evidence_strength": {
            "strong": [
              "deployment_record",
              "usage_data"
            ],
            "weak": [
              "user_feedback_record"
            ]
          }
        },
        {
          "stage": 8,
          "band": "Scale",
          "descriptor": "The product runs steadily for several users in different settings, with faults tracked and fixed.",
          "evidence_required": [
            "usage_data",
            "support_log",
            "release_log"
          ],
          "evidence_strength": {
            "strong": [
              "usage_data",
              "support_log"
            ],
            "weak": [
              "release_log"
            ]
          }
        },
        {
          "stage": 9,
          "band": "Scale",
          "descriptor": "The product serves many users at once, with staffed support, maintenance routines and measured reliability.",
          "evidence_required": [
            "uptime_report",
            "support_log",
            "usage_data"
          ],
          "evidence_strength": {
            "strong": [
              "uptime_report",
              "support_log"
            ],
            "weak": [
              "usage_data"
            ]
          }
        }
      ]
    },
    {
      "code": "BIZ",
      "name": "Business Model",
      "stages": [
        {
          "stage": 1,
          "band": "Explore",
          "descriptor": "The team cannot yet say who would pay, how much, or why.",
          "evidence_required": [
            "concept_note"
          ],
          "evidence_strength": {
            "strong": [
              "concept_note"
            ],
            "weak": []
          }
        },
        {
          "stage": 2,
          "band": "Explore",
          "descriptor": "The team has written down who pays, what they pay for, and how money would be collected.",
          "evidence_required": [
            "business_model_draft",
            "concept_note"
          ],
          "evidence_strength": {
            "strong": [
              "business_model_draft"
            ],
            "weak": [
              "concept_note"
            ]
          }
        },
        {
          "stage": 3,
          "band": "Explore",
          "descriptor": "The team has listed its costs and a proposed price, but has not checked them against real figures.",
          "evidence_required": [
            "pricing_document",
            "cost_breakdown",
            "business_model_draft"
          ],
          "evidence_strength": {
            "strong": [
              "pricing_document",
              "cost_breakdown"
            ],
            "weak": [
              "business_model_draft"
            ]
          }
        },
        {
          "stage": 4,
          "band": "Validate",
          "descriptor": "The proposed price has been put to potential customers and adjusted based on their responses.",
          "evidence_required": [
            "interview_log",
            "pricing_document"
          ],
          "evidence_strength": {
            "strong": [
              "interview_log"
            ],
            "weak": [
              "pricing_document"
            ]
          }
        },
        {
          "stage": 5,
          "band": "Validate",
          "descriptor": "The team calculates cost and income per sale from real figures and has chosen its routes to market.",
          "evidence_required": [
            "unit_economics_model",
            "cost_breakdown"
          ],
          "evidence_strength": {
            "strong": [
              "unit_economics_model"
            ],
            "weak": [
              "cost_breakdown"
            ]
          }
        },
        {
          "stage": 6,
          "band": "Validate",
          "descriptor": "Customers have paid the intended price in a pilot or test sale, and delivery steps are written down.",
          "evidence_required": [
            "invoice",
            "payment_record",
            "pricing_document"
          ],
          "evidence_strength": {
            "strong": [
              "invoice",
              "payment_record"
            ],
            "weak": [
              "pricing_document"
            ]
          }
        },
        {
          "stage": 7,
          "band": "Scale",
          "descriptor": "Sales come repeatedly through at least one channel, at a price that covers the cost of delivery.",
          "evidence_required": [
            "channel_data",
            "management_accounts",
            "unit_economics_model"
          ],
          "evidence_strength": {
            "strong": [
              "channel_data",
              "management_accounts"
            ],
            "weak": [
              "unit_economics_model"
            ]
          }
        },
        {
          "stage": 8,
          "band": "Scale",
          "descriptor": "Margins hold steady as volume grows, and the team has a written plan for expanding delivery.",
          "evidence_required": [
            "management_accounts",
            "unit_economics_model"
          ],
          "evidence_strength": {
            "strong": [
              "management_accounts"
            ],
            "weak": [
              "unit_economics_model"
            ]
          }
        },
        {
          "stage": 9,
          "band": "Scale",
          "descriptor": "The business grows through established channels with stable margins, and reports the same growth measures every period.",
          "evidence_required": [
            "audited_accounts",
            "management_accounts",
            "channel_data"
          ],
          "evidence_strength": {
            "strong": [
              "audited_accounts",
              "management_accounts"
            ],
            "weak": [
              "channel_data"
            ]
          }
        }
      ]
    },
    {
      "code": "MOT",
      "name": "Moat",
      "stages": [
        {
          "stage": 1,
          "band": "Explore",
